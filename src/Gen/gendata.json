RD '1'"]}]},{"g":"Безопасность и доступ","items":[{"id":"uacquiet","label":"UAC: не запрашивать подтверждение у администраторов","hint":"Контроль учётных записей остаётся включён","warn":"","rec":false,"os":"","lines":["RegSet 'HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' 'ConsentPromptBehaviorAdmin' REG_DWORD '0'"]},{"id":"uacoff","label":"Полностью отключить UAC","hint":"","warn":"Небезопасно, ломает работу приложений из Microsoft Store. Нужна перезагрузка.","rec":false,"os":"","lines":["RegSet 'HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' 'EnableLUA' REG_DWORD '0'"]},{"id":"smartscreen","label":"Отключить SmartScreen","hint":"","warn":"Отключает проверку скачанных файлов и сайтов на вредоносность.","rec":false,"os":"","lines":["RegSet 'HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System' 'EnableSmartScreen' REG_DWORD '0'"]},{"id":"firewall","label":"Отключить брандмауэр Windows","hint":"","warn":"Небезопасно для компьютеров в сети.","rec":false,"os":"","lines":["netsh.exe advfirewall set allprofiles state off | Out-Null"]},{"id":"bitlocker","label":"Запретить автоматическое шифрование BitLocker / шифрование устройства","hint":"","warn":"","rec":false,"os":"","lines":["RegSet 'HKLM\\SYSTEM\\CurrentControlSet\\Control\\BitLocker' 'PreventDeviceEncryption' REG_DWORD '1'"]}]},{"g":"Обновления","items":[{"id":"noautoupdate","label":"Отключить автоматическую установку обновлений (для всех пользователей)","hint":"Это политика уровня компьютера. Отдельно «для одного пользователя» Windows не поддерживает — параметры обновлений общие для всей системы.","warn":"","rec":false,"os":"","lines":["RegSet 'HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' 'NoAutoUpdate' REG_DWORD '1'"]},{"id":"notifyupdate","label":"Только уведомлять об обновлениях (скачивание и установка вручную)","hint":"","warn":"","rec":false,"os":"","lines":["RegSet 'HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' 'NoAutoUpdate' REG_DWORD '0'","RegSet 'HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' 'AUOptions' REG_DWORD '2'"]},{"id":"wusvc","label":"Полностью отключить службы обновления (wuauserv, UsoSvc, WaaSMedicSvc)","hint":"","warn":"Магазин и установка некоторых компонентов могут перестать работать. Служба WaaSMedicSvc защищена системой: запись может быть отклонена, тогда она останется и сможет включить обновления обратно.","rec":false,"os":"","lines":["RegSet 'HKLM\\SYSTEM\\CurrentControlSet\\Services\\wuauserv' 'Start' REG_DWORD '4'","RegSet 'HKLM\\SYSTEM\\CurrentControlSet\\Services\\UsoSvc' 'Start' REG_DWORD '4'","RegSet 'HKLM\\SYSTEM\\CurrentControlSet\\Services\\WaaSMedicSvc' 'Start' REG_DWORD '4'"]},{"id":"nowinver","label":"Остаться на текущей версии Windows 10 (не предлагать новую версию)","hint":"","warn":"","rec":false,"os":"10","lines":["RegSet 'HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate' 'TargetReleaseVersion' REG_DWORD '1'","RegSet 'HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate' 'TargetReleaseVersionInfo' REG_SZ '22H2'","RegSet 'HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate' 'ProductVersion' REG_SZ 'Windows 10'"]},{"id":"noreboot","label":"Не перезагружаться автоматически при активных пользователях","hint":"","warn":"","rec":false,"os":"","lines":["RegSet 'HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU' 'NoAutoRebootWithLoggedOnUsers' REG_DWORD '1'"]},{"id":"nodrivers","label":"Не устанавливать драйверы через Центр обновления","hint":"","warn":"","rec":false,"os":"","lines":["RegSet 'HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate' 'ExcludeWUDriversInQualityUpdate' REG_DWORD '1'"]},{"id":"dopt","label":"Отключить доставку обновлений из интернета другим ПК (Delivery Optimization)","hint":"","warn":"","rec":false,"os":"","lines":["RegSet 'HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization' 'DODownloadMode' REG_DWORD '0'"]}]},{"g":"Система и питание","items":[{"id":