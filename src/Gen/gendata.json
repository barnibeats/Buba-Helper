dvanced' 'Start_TrackDocs' REG_DWORD '0'"]}]}],"presets":[{"id":"home","title":"Домашний компьютер","desc":"Меньше рекламы и слежки, привычный Проводник, без лишних приложений. Защитник, обновления и UAC не трогаются."},{"id":"office","title":"Офисный компьютер","desc":"Для рабочей сети: меньше телеметрии, ответ на ping, общий доступ к файлам, сетевое обнаружение и RDP с NLA. Обновления остаются включёнными."},{"id":"privacy","title":"Максимум приватности","desc":"Отключает телеметрию, рекламу, журнал действий, геолокацию, отзывы, Copilot/Recall и фоновую работу Edge."},{"id":"dev","title":"Рабочее место разработчика","desc":"Расширения и скрытые файлы, длинные пути, тёмная тема, WSL и платформа виртуальных машин. Ставит Git, VS Code, Python, Terminal, PowerToys, 7-Zip, Notepad++ (нужен интернет)."},{"id":"kiosk","title":"Стенд / киоск","desc":"Автовход без ограничения числа раз, без экрана блокировки и сна, без автообновлений и перезагрузок. Подходит только для изолированных устройств."},{"id":"clean","title":"Чистые значения по умолчанию","desc":"Возвращает твики, приложения, Защитник, удалённый доступ и программы к состоянию «как при первом открытии». Остальные разделы не меняются."}]}